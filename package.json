{
  "name": "codex-telegram",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Privacy-first local Telegram user-account MCP server for Codex, powered by TDLib.",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "keywords": ["codex", "mcp", "telegram", "tdlib", "model-context-protocol"],
  "files": ["dist", "skills", ".codex-plugin", ".mcp.json", "README.md", "LICENSE"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "login": "tsx src/login.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/helpers.test.ts tests/policy.test.ts",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run plugin:validate",
    "setup": "tsx src/setup.ts"
    ,"migrate-legacy-config": "tsx src/migrateLegacyConfig.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "dotenv": "^16.6.1",
    "prebuilt-tdlib": "^0.1008052",
    "tdl": "^8.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
