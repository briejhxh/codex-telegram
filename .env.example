TG_API_ID=
TG_API_HASH=
TG_USE_DOTENV=1

# Server-side safety policy. The public default is read-only.
# Profiles: read-only, inbox, messaging, files, community-manager, admin, full-access
TG_POLICY_PROFILE=read-only
# Comma-separated numeric chat IDs. Writes are denied outside this list when it is set.
# TG_ALLOWED_CHAT_IDS=
# TG_DENIED_CHAT_IDS=
# Comma-separated tool names for a stricter custom policy.
# TG_ALLOWED_TOOLS=
# TG_DENIED_TOOLS=
# Directories from which files may be sent. Separate paths with the platform path delimiter.
# TG_FILE_ROOTS=
TG_MAX_SEND_FILE_BYTES=26214400
TG_MAX_WRITES_PER_MINUTE=20
# Required by destructive tools when using admin or full-access. Keep this local and random.
# One-time tokens are generated with `pnpm run approve ...`; never put them in Telegram.
# TG_DESTRUCTIVE_APPROVAL_SECRET=
# TG_DESTRUCTIVE_APPROVAL_TTL_SECONDS=120

# Optional named-account isolation. Configure a separate Codex MCP server for
# each name; this creates independent config, TDLib database, files, and policy.
# TG_ACCOUNT=personal

# Optional. Defaults to a private per-user directory:
# Windows: %LOCALAPPDATA%\codex-telegram
# macOS/Linux: ~/.local/state/codex-telegram
# TG_CONFIG_DIR=
#
# Optional custom TDLib locations. Prefer absolute paths.
# TG_DATABASE_DIR=
# TG_FILES_DIR=
# TG_DOWNLOADS_DIR=
# TG_MAX_DOWNLOAD_BYTES=104857600
